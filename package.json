{
  "name": "tremtec",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "a": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "w:build": "bun run build && bun w build",
    "preview": "astro preview",
    "lint": "biome lint . && astro check",
    "fix": "biome check --write --unsafe .",
    "test": "vitest",
    "w": "wrangler",
    "generate-types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=scripts/seed.dev.sql"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/inter": "^5.3.0",
    "@hono/oauth-providers": "^0.9.1",
    "@hono/zod-validator": "^0.9.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/mdi": "^1.2.3",
    "@pulumi/cloudflare": "^6.14.0",
    "@pulumi/command": "^1.2.1",
    "@pulumi/pulumi": "^3.230.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "astro-icon": "^1.2.0",
    "astro-mermaid": "^2.2.0",
    "daisyui": "^5.8.1",
    "hono": "^4.13.19",
    "htmx.org": "^2.0.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.164.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@vitest/ui": "^5.1.1",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "miniflare": "^4.20260730.0",
    "vitest": "^5.1.1"
  }
}
