---
import { initials } from "~/lib/format";

interface Props {
  name: string;
  src: string;
  size?: "sm" | "md" | "lg";
}

const { name, src, size = "md" } = Astro.props;
const sizes = {
  sm: "size-8 text-xs",
  md: "size-10 text-sm",
  lg: "size-12 text-base",
};
---

<!-- Initials sit underneath, so they show whenever the image fails to load -->
<span
  class={`relative inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full bg-primary/15 font-semibold text-primary ring-1 ring-base-content/10 ${sizes[size]}`}
>
  {initials(name)}
  <img
    src={src}
    alt=""
    loading="lazy"
    referrerpolicy="no-referrer"
    class="absolute inset-0 size-full object-cover"
  />
</span>
