---
import type { User } from "~/domain/user/schema";
import { localizePath } from "~/lib/i18n";
import { routes } from "~/server/contants";
import Logo from "~/ui/components/Logo.astro";
import { dashboardContent } from "~/ui/contents/dashboard";
import { landingContent } from "~/ui/contents/landing";
import LocaleSelect from "./LocaleSelect.astro";
import NavSection from "./NavSection.astro";
import UserCard from "./UserCard.astro";

interface Props {
  user?: User;
  isAdmin: boolean;
  currentPath: string;
}

const { user, isAdmin, currentPath } = Astro.props;
const locale = Astro.locals.locale;
const { nav, products, shell } = dashboardContent[locale];
const workspace = [...nav.workspace, ...(isAdmin ? nav.admin : [])];
---

<aside class="flex min-h-full w-72 flex-col border-r border-base-content/10 bg-base-200/80 backdrop-blur-xl">
  <a
    href={localizePath(locale, routes.public.home)}
    class="flex h-16 items-center gap-3 border-b border-base-content/10 px-6 transition-opacity hover:opacity-80"
  >
    <Logo size={32} />
    <span class="text-lg font-bold tracking-tight">{landingContent[locale].navbar.logo}</span>
  </a>

  <nav class="flex flex-1 flex-col gap-8 overflow-y-auto px-4 py-6">
    <NavSection title={shell.workspace} items={workspace} currentPath={currentPath} />
    <NavSection
      title={shell.products}
      items={products.map(({ name, icon, accent }) => ({ label: name, icon, accent }))}
      currentPath={currentPath}
    />
  </nav>

  <div class="px-4 pb-2">
    <LocaleSelect />
  </div>

  {user && <UserCard user={user} />}
</aside>
