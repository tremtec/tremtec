---
interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const { title, subtitle, class: className = "" } = Astro.props;
---

<section
  class={`rounded-2xl border border-base-content/10 bg-base-200/60 p-6 backdrop-blur ${className}`}
>
  {
    (title || Astro.slots.has("action")) && (
      <div class="mb-4 flex items-center justify-between gap-4">
        <div>
          {title && <h3 class="font-semibold">{title}</h3>}
          {subtitle && <p class="text-sm text-base-content/50">{subtitle}</p>}
        </div>
        <slot name="action" />
      </div>
    )
  }
  <slot />
</section>
