---
import type { UserMetrics } from "~/domain/user/schema";
import { plural } from "~/lib/format";
import { dashboardContent } from "~/ui/contents/dashboard";
import StatCard from "./StatCard.astro";

interface Props {
  metrics: UserMetrics;
}

const { metrics } = Astro.props;
const locale = Astro.locals.locale;
const { metrics: content } = dashboardContent[locale];
---

<section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label={content.label}>
  <StatCard
    label={content.total}
    value={metrics.total}
    hint={plural(metrics.admins, locale, content.admins)}
    icon="heroicons:users"
  />
  <StatCard label={content.active} value={metrics.active} hint={content.activeHint} icon="heroicons:check-badge" tone="success" />
  <StatCard
    label={content.pending}
    value={metrics.pending}
    hint={metrics.pending ? content.pendingHint : content.pendingNone}
    icon="heroicons:clock"
    tone="warning"
  />
  <StatCard
    label={content.newThisWeek}
    value={metrics.newThisWeek}
    hint={plural(metrics.suspended, locale, content.suspended)}
    icon="heroicons:sparkles"
  />
</section>
