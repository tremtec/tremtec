---
import { dashboardContent } from "~/ui/contents/dashboard";
import ProductCard from "./ProductCard.astro";

const { roadmap, products } = dashboardContent[Astro.locals.locale];
---

<section>
  <div class="mb-5">
    <h3 class="text-xl font-bold">{roadmap.title}</h3>
    <p class="text-sm text-base-content/50">{roadmap.subtitle}</p>
  </div>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {products.map((product) => <ProductCard product={product} />)}
  </div>
</section>
