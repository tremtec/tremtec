---
import { Icon } from "astro-icon/components";
import { roleEnum, statusEnum, type User } from "~/domain/user/schema";
import { timeAgo } from "~/lib/format";
import { dashboardContent } from "~/ui/contents/dashboard";
import { usersContent } from "~/ui/contents/users";
import Avatar from "../Avatar.astro";

interface Props {
  user: User;
  /** The signed-in admin: their own row is read-only */
  isMe: boolean;
}

const { user, isMe } = Astro.props;
const locale = Astro.locals.locale;
const { table } = usersContent[locale];
const { roles, statuses, providers } = dashboardContent[locale];
const selectClass =
  "select select-sm w-40 rounded-lg border-base-content/15 bg-base-100/60";
const endpoint = `/api/users/${user.id}`;
---

<tr class="border-base-content/10 transition-colors hover:bg-base-content/[0.03]">
  <td class="pl-6">
    <div class="flex items-center gap-3">
      <Avatar name={user.name} src={user.avatar} />
      <div class="min-w-0">
        <p class="flex items-center gap-2 font-medium">
          {user.name}
          {isMe && <span class="rounded-full bg-primary/15 px-2 py-0.5 text-[10px] font-semibold uppercase text-primary">{table.you}</span>}
        </p>
        <p class="text-xs text-base-content/50">{user.email}</p>
      </div>
    </div>
  </td>
  <td>
    <span class="inline-flex items-center gap-1.5 text-sm text-base-content/70">
      <Icon name={user.provider === "github" ? "mdi:github" : "mdi:google"} class="size-4" />
      {providers[user.provider]}
    </span>
  </td>
  <td>
    <select
      name="role"
      class={selectClass}
      aria-label={table.roleFor(user.name)}
      disabled={isMe}
      hx-patch={endpoint}
      hx-trigger="change"
      hx-swap="none"
    >
      {roleEnum.options.map((r) => <option value={r} selected={user.role === r}>{roles[r]}</option>)}
    </select>
  </td>
  <td>
    <select
      name="status"
      class={selectClass}
      aria-label={table.statusFor(user.name)}
      disabled={isMe}
      hx-patch={endpoint}
      hx-trigger="change"
      hx-swap="none"
    >
      {statusEnum.options.map((s) => <option value={s} selected={user.status === s}>{statuses[s]}</option>)}
    </select>
  </td>
  <td class="whitespace-nowrap text-sm text-base-content/60">{timeAgo(user.lastLoginAt, locale)}</td>
  <td class="pr-6 text-right">
    {
      !isMe && (
        <button
          type="button"
          class="btn btn-ghost btn-square btn-sm text-base-content/50 hover:bg-error/10 hover:text-error"
          aria-label={table.deleteLabel(user.name)}
          title={table.deleteTitle}
          hx-delete={endpoint}
          hx-confirm={table.deleteConfirm(user.name)}
          hx-swap="none"
        >
          <Icon name="heroicons:trash" class="size-4" />
        </button>
      )
    }
  </td>
</tr>
