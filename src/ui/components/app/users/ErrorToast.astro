<div id="toast" class="toast toast-end toast-bottom z-50" role="status" aria-live="polite"></div>

<script>
  // On a failed change, tell the admin why and put the page back in sync
  document.body.addEventListener("htmx:responseError", (event) => {
    const { xhr } = (event as CustomEvent<{ xhr: XMLHttpRequest }>).detail;
    let message = "Something went wrong";
    try {
      message = JSON.parse(xhr.responseText).error ?? message;
    } catch {}

    const toast = document.getElementById("toast");
    if (toast) {
      const alert = document.createElement("div");
      alert.className = "alert alert-error shadow-lg";
      alert.textContent = message;
      toast.replaceChildren(alert);
    }
    setTimeout(() => location.reload(), 1800);
  });
</script>
