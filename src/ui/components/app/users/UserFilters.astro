---
import { Icon } from "astro-icon/components";
import {
  type ListUsersQuery,
  roleEnum,
  statusEnum,
} from "~/domain/user/schema";
import { routes } from "~/server/contants";

interface Props {
  query: ListUsersQuery;
}

const { query } = Astro.props;
const hasFilters = Boolean(query.q || query.role || query.status);
const selectClass =
  "select select-sm w-28 rounded-lg border-base-content/15 bg-base-100/60 capitalize";
---

<form
  method="get"
  class="flex flex-wrap items-center gap-3 rounded-2xl border border-base-content/10 bg-base-200/60 p-4 backdrop-blur"
>
  <label class="input input-sm flex min-w-56 flex-1 items-center gap-2 rounded-lg border-base-content/15 bg-base-100/60">
    <Icon name="heroicons:magnifying-glass" class="size-4 text-base-content/40" />
    <input type="search" name="q" value={query.q ?? ""} placeholder="Search name, email or login" class="grow" />
  </label>
  <select name="role" class={selectClass} aria-label="Filter by role">
    <option value="">All roles</option>
    {roleEnum.options.map((r) => <option value={r} selected={query.role === r}>{r}</option>)}
  </select>
  <select name="status" class={selectClass} aria-label="Filter by status">
    <option value="">All statuses</option>
    {statusEnum.options.map((s) => <option value={s} selected={query.status === s}>{s}</option>)}
  </select>
  <button type="submit" class="btn btn-primary btn-sm">Apply</button>
  {hasFilters && <a href={routes.private.users} class="btn btn-ghost btn-sm">Clear</a>}
</form>
