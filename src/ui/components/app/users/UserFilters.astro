---
import { Icon } from "astro-icon/components";
import {
  type ListUsersQuery,
  roleEnum,
  statusEnum,
} from "~/domain/user/schema";
import { routes } from "~/server/contants";
import { dashboardContent } from "~/ui/contents/dashboard";
import { usersContent } from "~/ui/contents/users";

interface Props {
  query: ListUsersQuery;
}

const { query } = Astro.props;
const locale = Astro.locals.locale;
const { filters } = usersContent[locale];
const { roles, statuses } = dashboardContent[locale];
const hasFilters = Boolean(query.q || query.role || query.status);
const selectClass =
  "select select-sm min-w-36 flex-1 sm:w-40 sm:flex-none rounded-lg border-base-content/15 bg-base-100/60";
---

<form
  method="get"
  class="flex flex-wrap items-center gap-3 rounded-2xl border border-base-content/10 bg-base-200/60 p-4 backdrop-blur"
>
  <label class="input input-sm flex min-w-56 flex-1 items-center gap-2 rounded-lg border-base-content/15 bg-base-100/60">
    <Icon name="heroicons:magnifying-glass" class="size-4 text-base-content/40" />
    <input type="search" name="q" value={query.q ?? ""} placeholder={filters.searchPlaceholder} class="grow" />
  </label>
  <select name="role" class={selectClass} aria-label={filters.roleLabel}>
    <option value="">{filters.allRoles}</option>
    {roleEnum.options.map((r) => <option value={r} selected={query.role === r}>{roles[r]}</option>)}
  </select>
  <select name="status" class={selectClass} aria-label={filters.statusLabel}>
    <option value="">{filters.allStatuses}</option>
    {statusEnum.options.map((s) => <option value={s} selected={query.status === s}>{statuses[s]}</option>)}
  </select>
  <button type="submit" class="btn btn-primary btn-sm">{filters.apply}</button>
  {hasFilters && <a href={routes.private.users} class="btn btn-ghost btn-sm">{filters.clear}</a>}
</form>
