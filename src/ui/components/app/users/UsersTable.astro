---
import { Icon } from "astro-icon/components";
import type { User } from "~/domain/user/schema";
import { usersContent } from "~/ui/contents/users";
import Pagination from "./Pagination.astro";
import UserRow from "./UserRow.astro";

interface Props {
  users: User[];
  currentUserId: string;
  page: number;
  pages: number;
  from: number;
  to: number;
  total: number;
  hrefFor: (page: number) => string;
}

const { users, currentUserId, ...pagination } = Astro.props;
const { table } = usersContent[Astro.locals.locale];
---

<div class="overflow-hidden rounded-2xl border border-base-content/10 bg-base-200/60 backdrop-blur">
  <div class="overflow-x-auto">
    <table class="table min-w-[52rem]">
      <thead>
        <tr class="border-base-content/10 text-xs uppercase tracking-wider text-base-content/50">
          <th class="pl-6">{table.user}</th>
          <th>{table.provider}</th>
          <th>{table.role}</th>
          <th>{table.status}</th>
          <th>{table.lastActive}</th>
          <th class="pr-6"><span class="sr-only">{table.actions}</span></th>
        </tr>
      </thead>
      <tbody>
        {users.map((user) => <UserRow user={user} isMe={user.id === currentUserId} />)}
      </tbody>
    </table>
  </div>

  {
    users.length === 0 && (
      <div class="flex flex-col items-center gap-2 px-6 py-16 text-center">
        <span class="flex size-14 items-center justify-center rounded-2xl bg-base-content/5">
          <Icon name="heroicons:users" class="size-7 text-base-content/40" />
        </span>
        <p class="font-semibold">{table.empty.title}</p>
        <p class="text-sm text-base-content/50">{table.empty.hint}</p>
      </div>
    )
  }

  <Pagination {...pagination} />
</div>
