---
import type { UserMetrics } from "~/domain/user/schema";
import { dashboardContent } from "~/ui/contents/dashboard";
import Panel from "./Panel.astro";
import ProviderSplit from "./ProviderSplit.astro";

interface Props {
  byProvider: UserMetrics["byProvider"];
}

const { byProvider } = Astro.props;
const { provider } = dashboardContent[Astro.locals.locale];
---

<Panel title={provider.title} subtitle={provider.subtitle}>
  <div class="mt-6">
    <ProviderSplit github={byProvider.github} google={byProvider.google} />
  </div>
</Panel>
