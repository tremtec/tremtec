---
import { Icon } from "astro-icon/components";
import {
  type DashboardContent,
  dashboardContent,
} from "~/ui/contents/dashboard";

type Props = { product: DashboardContent["products"][number] };

const { product } = Astro.props;
const { roadmap } = dashboardContent[Astro.locals.locale];
---

<article
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-base-content/10 bg-base-200/60 p-6 backdrop-blur transition-all hover:-translate-y-1 hover:shadow-2xl"
>
  <div
    class={`pointer-events-none absolute inset-0 bg-gradient-to-br opacity-70 transition-opacity group-hover:opacity-100 ${product.gradient}`}
  >
  </div>

  <div class="relative flex items-start justify-between">
    <span class="flex size-12 items-center justify-center rounded-xl bg-base-100/80 shadow-sm ring-1 ring-base-content/10">
      <Icon name={product.icon} class={`size-6 ${product.accent}`} />
    </span>
    <span class="rounded-full bg-base-100/80 px-3 py-1 text-xs font-semibold text-base-content/60 ring-1 ring-base-content/10">
      {roadmap.comingSoon}
    </span>
  </div>

  <h3 class="relative mt-5 text-xl font-bold">{product.name}</h3>
  <p class="relative text-xs font-medium uppercase tracking-wide text-base-content/50">
    {product.tagline}
  </p>
  <p class="relative mt-3 text-sm leading-relaxed text-base-content/70">{product.description}</p>
</article>
