---
import "~/ui/styles/global.css";

import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang } from "~/i18n/ui";
import { useTranslations } from "~/i18n/utils";
import Footer from "~/ui/components/Footer.astro";
import Logo from "~/ui/components/Logo.astro";
import Navbar from "~/ui/components/Navbar.astro";
import OpenGraph from "~/ui/components/OpenGraph.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  author?: string;
  publishedTime?: string;
  updatedTime?: string;
  section?: string;
  hideNavbar?: boolean;
}

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? defaultLang;

const links = [
  { label: t("nav.home"), href: getRelativeLocaleUrl(locale) },
  { label: t("nav.services"), href: getRelativeLocaleUrl(locale, "services") },
  { label: t("nav.blog"), href: getRelativeLocaleUrl(locale, "blog") },
];

const trim = (p: string) =>
  p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p;
const pathname = trim(Astro.originPathname);
const isActive = (href: string) =>
  href.startsWith("#") ? false : pathname.startsWith(trim(href));

const {
  title = "TremTec",
  description = "TremTec Software Solutions",
  image = "/images/train-og.webp",
  type = "website",
  author,
  publishedTime,
  updatedTime,
  section,
  hideNavbar = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="TremTec Blog RSS Feed" href="/rss.xml" />

    <OpenGraph
      title={title}
      description={description}
      image={image}
      type={type}
      author={author}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
      section={section}
    />

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-base-100 text-base-content antialiased">
    <script>
      import 'htmx.org';
    </script>
    <div class="drawer">
      <input id="mobile-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex flex-col min-h-screen">
        {hideNavbar 
          ? <slot />
          : (
            <Navbar />

            <!-- Content -->
            <div class="w-full flex-1 py-4 mt-20">
              <slot />
            </div>

            <Footer />
          )}
      </div>

      <div class="drawer-side z-50">
        <label for="mobile-drawer" class="drawer-overlay"></label>

        <ul class="menu p-4 w-80 min-h-full bg-base-200 gap-2 flex flex-col">
          <div class="spacer mt-4 mb-8">
            <a
              href={getRelativeLocaleUrl(locale)}
              class="flex dark:text-white items-center gap-2"
            >
              <Logo />
              <span class="text-lg font-bold">TremTec</span>
            </a>
          </div>

          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={`text-lg font-medium ${isActive(link.href) ? "text-primary" : ""}`}
                  onclick="document.getElementById('mobile-drawer').click()"
                >
                  {link.label}
                </a>
              </li>
            ))
          }

          <div class="spacer flex-1"></div>

          <li class="mt-4 py-4 gap-4 flex flex-col border-t border-base-300">
            <a
              href={getRelativeLocaleUrl(locale, "login")}
              class="text-lg font-medium"
              onclick="document.getElementById('mobile-drawer').click()"
            >
              {t("nav.login")}
            </a>
            <a
              href={getRelativeLocaleUrl(locale, "contact")}
              class="btn btn-primary btn-sm font-medium px-6"
            >
              {t("nav.getStarted")}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </body>
</html>
