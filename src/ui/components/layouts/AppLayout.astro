---
import "~/ui/styles/global.css";
import { LOCALE_INFO } from "~/domain/shared/locale";
import { isAdmin } from "~/lib/session";
import AmbientBackground from "~/ui/components/app/shell/AmbientBackground.astro";
import Sidebar from "~/ui/components/app/shell/Sidebar.astro";
import TopBar from "~/ui/components/app/shell/TopBar.astro";
import ErrorToast from "~/ui/components/app/users/ErrorToast.astro";
import OpenGraph from "~/ui/components/OpenGraph.astro";
import { dashboardContent } from "~/ui/contents/dashboard";

interface Props {
  title?: string;
  description?: string;
  /** Page heading shown in the top bar */
  heading?: string;
}

const DRAWER_ID = "app-drawer";

const locale = Astro.locals.locale;
const { metadata, shell } = dashboardContent[locale];

const { title = "TremTec", description = metadata.description } = Astro.props;
const heading = Astro.props.heading ?? title;

const user = Astro.locals.user;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang={LOCALE_INFO[locale].tag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <OpenGraph title={title} description={description} />

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-base-100 text-base-content antialiased">
    <script>
      import "htmx.org";
    </script>

    <AmbientBackground />

    <div class="drawer lg:drawer-open">
      <input id={DRAWER_ID} type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex min-h-screen flex-col">
        <TopBar heading={heading} user={user} drawerId={DRAWER_ID} />
        <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-8">
          <slot />
        </main>
      </div>

      <div class="drawer-side z-40">
        <label for={DRAWER_ID} aria-label={shell.closeMenu} class="drawer-overlay"></label>
        <Sidebar user={user} isAdmin={isAdmin(user)} currentPath={currentPath} />
      </div>
    </div>

    <ErrorToast />
  </body>
</html>
