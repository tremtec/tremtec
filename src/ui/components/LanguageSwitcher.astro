---
import { defaultLang, languages } from "~/i18n/ui";
import { useTranslations } from "~/i18n/utils";
import { getRelativeLocaleUrlList } from "astro:i18n";

interface Props {
  path?: string;
}

const { path } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const current = Astro.currentLocale ?? defaultLang;

// both lists follow the order of `i18n.locales`
const urls = getRelativeLocaleUrlList(path);
const links = Object.entries(languages).map(([lang, label], i) => ({
  lang,
  label,
  href: urls[i],
}));
---

<nav aria-label={t("switcher.label")} class="flex items-center gap-1">
  {
    links.map((link) => (
      <a
        href={link.href}
        hreflang={link.lang}
        lang={link.lang}
        aria-current={link.lang === current ? "page" : undefined}
        class={`btn btn-ghost btn-xs ${link.lang === current ? "text-primary" : "text-base-content/60 hover:text-primary"}`}
      >
        {link.label}
      </a>
    ))
  }
</nav>
