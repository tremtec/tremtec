---
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang } from "~/i18n/ui";
import { useTranslations } from "~/i18n/utils";
import Logo from "~/ui/components/Logo.astro";

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? defaultLang;
const services = getRelativeLocaleUrl(locale, "services");

const sections = [
  {
    title: t("footer.services.title"),
    links: [
      { label: t("footer.services.implementation"), href: services },
      { label: t("footer.services.cto"), href: services },
      { label: t("footer.services.mentoring"), href: services },
    ],
  },
  {
    title: t("footer.company.title"),
    links: [
      { label: t("footer.company.about"), href: "#about" },
      { label: t("footer.company.methodology"), href: "#methodology" },
      {
        label: t("footer.company.blog"),
        href: getRelativeLocaleUrl(locale, "blog"),
      },
      {
        label: t("footer.company.contact"),
        href: getRelativeLocaleUrl(locale, "contact"),
      },
    ],
  },
  {
    title: t("footer.connect.title"),
    socials: [
      {
        label: "GitHub",
        icon: "mdi:github",
        href: "https://github.com/tremtec",
      },
      {
        label: "LinkedIn",
        icon: "mdi:linkedin",
        href: "https://www.linkedin.com/company/tremtec/",
      },
    ],
  },
];

const legal = [
  { label: t("footer.privacy"), href: "#" },
  { label: t("footer.terms"), href: "#" },
];
const currentYear = new Date().getFullYear();
---

<footer class="bg-base-100 border-t border-base-200 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <div class="col-span-2 md:col-span-1">
        <a href={getRelativeLocaleUrl(locale)} class="flex items-center gap-2">
          <Logo />
          <span class="text-lg font-bold">TremTec</span>
        </a>
        <p class="mt-4 text-sm text-base-content/60">
          {t("footer.description")}
        </p>
      </div>

      {
        sections.map((section) => (
          <div>
            <h3 class="text-sm font-semibold text-base-content tracking-wider uppercase mb-4">
              {section.title}
            </h3>
            {section.links && (
              <ul class="space-y-3">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-base-content/60 hover:text-primary transition-colors"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {section.socials && (
              <div class="flex space-x-4">
                {section.socials.map((social) => (
                  <a
                    href={social.href}
                    class="text-base-content/40 hover:text-primary transition-colors"
                  >
                    <span class="sr-only">{social.label}</span>
                    <Icon name={social.icon} class="h-6 w-6" />
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>

    <div
      class="border-t border-base-200 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="text-sm text-base-content/40">
        &copy; {currentYear} TremTec. {t("footer.rights")}
      </p>
      <div class="flex space-x-6">
        {
          legal.map((link) => (
            <a
              href={link.href}
              class="text-sm text-base-content/40 hover:text-base-content"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
