---
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang } from "~/i18n/ui";
import { useTranslations } from "~/i18n/utils";
import LanguageSwitcher from "~/ui/components/LanguageSwitcher.astro";
import Logo from "~/ui/components/Logo.astro";

interface Props {
  path?: string;
}

const { path } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? defaultLang;

const links = [
  { label: t("nav.home"), href: getRelativeLocaleUrl(locale) },
  { label: t("nav.services"), href: getRelativeLocaleUrl(locale, "services") },
  { label: t("nav.products"), href: getRelativeLocaleUrl(locale, "products") },
  { label: t("nav.blog"), href: getRelativeLocaleUrl(locale, "blog") },
];

const trim = (p: string) =>
  p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p;
const pathname = trim(Astro.originPathname);
const isActive = (href: string) => pathname === trim(href);
---

<div
  class="navbar fixed top-0 w-full z-50 transition-all duration-300 bg-base-100/80 backdrop-blur-md border-b border-base-200/50"
>
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center w-full">
      <!-- Left: Logo -->
      <div class="flex-shrink-0 flex items-center gap-2">
        <a href={getRelativeLocaleUrl(locale)} class="flex items-center gap-2">
          <Logo />
          <span class="text-lg font-bold">TremTec</span>
        </a>
      </div>

      <!-- Center: Navigation (Desktop) -->
      <div class="hidden md:flex items-center space-x-8">
        {
          links.map((link) => (
            <a
              href={link.href}
              class={`text-sm font-medium transition-colors ${isActive(link.href) ? "text-primary" : "text-base-content/80 hover:text-primary"}`}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- Right: CTA -->
      <div class="hidden md:flex items-center gap-4">
        <LanguageSwitcher path={path} />
        <a
          href={getRelativeLocaleUrl(locale, "login")}
          class="text-sm font-medium text-base-content/80 hover:text-primary transition-colors"
        >
          {t("nav.login")}
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "contact")}
          class="btn btn-primary btn-sm font-medium px-6"
        >
          {t("nav.getStarted")}
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center md:hidden gap-4">
        <label
          aria-label={t("nav.openMenu")}
          for="mobile-drawer"
          class="btn btn-square btn-ghost"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            class="inline-block w-6 h-6 stroke-current"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </label>
      </div>
    </div>
  </div>
</div>
