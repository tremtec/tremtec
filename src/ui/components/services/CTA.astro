---
import { useTranslations } from "~/i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<!-- CTA -->
<section class="bg-base-200 px-6 py-20" id="contact">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-4xl font-bold mb-6 text-base-content">
      {t("services.cta.title")}
    </h2>
    <p class="text-lg text-base-content/70 mb-8 max-w-2xl mx-auto">
      {t("services.cta.description")}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="mailto:hello@tremtec.com?subject=Inquiry%20about%20services"
          class="btn btn-primary font-bold">
        {t("services.cta.book")}
      </a>
      <a href="#"
          class="btn btn-outline">
        {t("services.cta.caseStudies")}
      </a>
    </div>
    <p class="text-sm text-base-content/60 mt-6">
      {t("services.cta.emailBefore")} <strong>hello@tremtec.com</strong> {t("services.cta.emailAfter")}
    </p>
  </div>
</section>
