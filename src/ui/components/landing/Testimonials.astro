---
import { Icon } from "astro-icon/components";
import { useTranslations } from "~/i18n/utils";

const t = useTranslations(Astro.currentLocale);
const items = [
  {
    company: "MeHabilite",
    service: t("home.testimonials.mehabilite.service"),
    outcome: t("home.testimonials.mehabilite.outcome"),
    icon: "heroicons:rocket-launch",
  },
  {
    company: "PodCodar",
    service: t("home.testimonials.podcodar.service"),
    outcome: t("home.testimonials.podcodar.outcome"),
    icon: "heroicons:users",
  },
  {
    company: "Devopness",
    service: t("home.testimonials.devopness.service"),
    outcomes: [
      t("home.testimonials.devopness.outcome1"),
      t("home.testimonials.devopness.outcome2"),
    ],
    icon: "heroicons:chart-bar-square",
  },
];
---

<!-- Testimonials / Client Wins Section -->
<div class="py-24 bg-base-100">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-2xl mb-12 mx-auto text-center">
      <h2
        class="text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
      >
        {t("home.testimonials.title")}
      </h2>
      <p class="mt-6 text-lg leading-8 text-base-content/70">
        {t("home.testimonials.description")}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        items.map((item) => (
          <div class="card bg-base-200 border border-base-300 hover:border-primary/50 transition-colors">
            <div class="card-body">
              <div class="p-3 rounded-lg w-fit bg-primary/10 mb-4">
                <Icon name={item.icon} class="w-8 h-8 text-primary" />
              </div>

              <h3 class="card-title text-xl text-base-content">
                {item.company}
              </h3>

              <p class="text-sm font-medium text-primary mb-3">
                {item.service}
              </p>

              {item.outcomes ? (
                <ul class="space-y-2">
                  {item.outcomes.map((outcome) => (
                    <li class="text-lg font-semibold text-base-content flex items-start gap-2">
                      <span class="text-secondary flex-shrink-0">✓</span>
                      {outcome}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-lg font-semibold text-base-content">
                  {item.outcome}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
