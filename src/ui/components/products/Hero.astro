---
import { useTranslations } from "~/i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<!-- Hero -->
<section class="px-6 py-20 max-w-6xl mx-auto text-center">
  <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-4">{t("products.hero.eyebrow")}</p>
  <h1 class="text-5xl font-bold text-base-content mb-6">
    {t("products.hero.title")}
  </h1>
  <p class="text-xl text-base-content/70 max-w-3xl mx-auto">
    {t("products.hero.description")}
  </p>
</section>
