---
import "~/ui/styles/global.css";
import { useTranslations } from "~/i18n/utils";
import About from "~/ui/components/landing/About.astro";
import CTA from "~/ui/components/landing/CTA.astro";
import Hero from "~/ui/components/landing/Hero.astro";
import Methodology from "~/ui/components/landing/Methodology.astro";
import Services from "~/ui/components/landing/Services.astro";
import Testimonials from "~/ui/components/landing/Testimonials.astro";
import TrustedBy from "~/ui/components/landing/TrustedBy.astro";
import Layout from "~/ui/components/layouts/Layout.astro";

const t = useTranslations(Astro.currentLocale);
---

<Layout title={t("home.title")} description={t("home.description")}>
  <Hero />
  <TrustedBy />
  <Testimonials />
  <Services />
  <Methodology />
  <About />
  <CTA />
</Layout>
