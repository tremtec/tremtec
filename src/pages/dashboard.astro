---
import { isAdmin as hasAdminAccess, requireUser } from "~/lib/session";
import MetricsGrid from "~/ui/components/app/MetricsGrid.astro";
import PendingNotice from "~/ui/components/app/PendingNotice.astro";
import ProductsSection from "~/ui/components/app/ProductsSection.astro";
import ProviderCard from "~/ui/components/app/ProviderCard.astro";
import RecentSignups from "~/ui/components/app/RecentSignups.astro";
import SignupsCard from "~/ui/components/app/SignupsCard.astro";
import WelcomeHeader from "~/ui/components/app/WelcomeHeader.astro";
import AppLayout from "~/ui/components/layouts/AppLayout.astro";

export const prerender = false;

const user = requireUser(Astro.locals);
const isAdmin = hasAdminAccess(user);

// Only admins see platform numbers
const { users } = Astro.locals.services;
const [metrics, recent] = isAdmin
  ? await Promise.all([
      users.getMetrics(),
      users.listUsers({ limit: 5, offset: 0 }),
    ])
  : [null, null];
---

<AppLayout title="Dashboard | TremTec" heading="Dashboard">
  <div class="space-y-10">
    <WelcomeHeader name={user.name} isAdmin={isAdmin} />
    {user.status === "pending" && <PendingNotice />}

    {
      metrics && recent && (
        <>
          <MetricsGrid metrics={metrics} />
          <section class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            <SignupsCard data={metrics.signupsByDay} class="lg:col-span-2" />
            <ProviderCard byProvider={metrics.byProvider} />
          </section>
          <RecentSignups users={recent.users} />
        </>
      )
    }

    <ProductsSection />
  </div>
</AppLayout>
