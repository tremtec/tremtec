---
import { useTranslations } from "~/i18n/utils";
import Layout from "~/ui/components/layouts/Layout.astro";
import Catalog from "~/ui/components/products/Catalog.astro";
import CTA from "~/ui/components/products/CTA.astro";
import Hero from "~/ui/components/products/Hero.astro";

const t = useTranslations(Astro.currentLocale);
---

<Layout title={t("products.title")} description={t("products.description")}>
  <Hero />
  <Catalog />
  <CTA />
</Layout>
