---
import type { ProductCategory } from "~/content.config";
import { localeStaticPaths, localizePath } from "~/lib/i18n";
import Layout from "~/ui/components/layouts/Layout.astro";
import { productsContent } from "~/ui/contents/products";
import { getCollection } from "astro:content";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.locals.locale;
const {
  metadata,
  hero,
  categories: categoryLabels,
  viewOnGithub,
  cta,
} = productsContent[locale];

// The collection has no stable order, so list by name within a category and
// by the dictionary's category order.
const products = (await getCollection("products"))
  .map((p) => p.data)
  .sort((a, b) => a.name.localeCompare(b.name));
const categories = (Object.keys(categoryLabels) as ProductCategory[]).filter(
  (category) => products.some((p) => p.category === category),
);

const categoryIcons: Record<ProductCategory, string> = {
  "ai-agents": "🤖",
  "security-compliance": "🔒",
  devops: "🚀",
  observability: "📡",
  "system-automation": "⚙️",
};
---

<Layout title={metadata.title} description={metadata.description}>
  <!-- Hero -->
  <section class="px-6 py-20 max-w-6xl mx-auto text-center">
    <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-4">{hero.eyebrow}</p>
    <h1 class="text-5xl font-bold text-base-content mb-6">
      {hero.title}
    </h1>
    <p class="text-xl text-base-content/70 max-w-3xl mx-auto">
      {hero.subtitle}
    </p>
  </section>

  <!-- Products by Category -->
  {categories.map((category) => (
    <section class="px-6 pb-16 max-w-6xl mx-auto">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-2xl">{categoryIcons[category]}</span>
        <h2 class="text-3xl font-bold text-base-content">{categoryLabels[category]}</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {products
          .filter((p) => p.category === category)
          .map((product) => (
            <div class="bg-base-100 border border-base-300 rounded-lg p-6 hover:shadow-lg transition flex flex-col">
              <h3 class="text-xl font-bold text-base-content mb-2">{product.name}</h3>
              <p class="text-base-content/70 mb-4 flex-1">{product.description[locale]}</p>
              <div class="flex flex-wrap gap-2 mb-4">
                {product.techStack.map((tech) => (
                  <span class="badge badge-outline badge-sm">{tech}</span>
                ))}
              </div>
              <a href={product.github} target="_blank" rel="noopener noreferrer" class="text-primary font-semibold text-sm hover:text-primary/80 transition inline-flex items-center gap-1">
                {viewOnGithub}
              </a>
            </div>
          ))}
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="bg-base-200 px-6 py-20">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-6 text-base-content">
        {cta.title}
      </h2>
      <p class="text-lg text-base-content/70 mb-8 max-w-2xl mx-auto">
        {cta.subtitle}
      </p>
      <a href={localizePath(locale, cta.href)} class="btn btn-primary font-bold">
        {cta.button}
      </a>
    </div>
  </section>
</Layout>
